# Server Configuration
PORT=5000

# Database Configuration
# For Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/student_productivity_hub
# For MongoDB Atlas (Cloud), replace with:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/student_productivity_hub?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=student_productivity_hub_secret_key_jwt_2026

# Token Expiry (e.g., 7d = 7 days)
JWT_EXPIRES_IN=7d
